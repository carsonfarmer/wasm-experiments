package wp:demo@0.1.0;

/// Every kind of WIT value, for round-trip tests.
interface menagerie {
  flags perms { read, write, exec }

  enum color { red, green, blue }

  record point {
    x: s32,
    y: s32,
    tag: option<string>,
  }

  variant shape {
    circle(f64),
    rect(tuple<u32, u32>),
    label(string),
    points(list<point>),
    empty,
  }

  record row {
    id: u64,
    flag: bool,
    tiny: s8,
    small: u16,
    medium: s32,
    single: f32,
    double: f64,
    letter: char,
    name: string,
    tags: list<string>,
    nums: list<u32>,
    nested: list<list<string>>,
    points: list<point>,
    maybe: option<string>,
    outcome: result<string, u32>,
    check: result<_, string>,
    shape: shape,
    color: color,
    perms: perms,
    pair: tuple<string, list<u8>>,
    bytes: list<u8>,
    nothing: list<string>,
  }
}

/// Emits `count` deterministic rows derived from `seed`, in odd-sized batches.
world zoo {
  use menagerie.{row};
  export run: async func(count: u64, seed: u64) -> stream<row>;
}

/// Regenerates the rows `zoo` should have sent; returns how many arrived intact.
world zoo-check {
  use menagerie.{row};
  export run: async func(input: stream<row>, count: u64, seed: u64) -> u64;
}
